# ==============================================================================
# SpectralBL Project Git Isolation Architecture
# ==============================================================================

# 1. Package Management & Reproducible State
# TRACK Manifest.toml to enforce bit-perfect environment reconstruction via Pkg.instantiate()
.julia/refs/

# 2. Data Safety Gates (Strict Binary Ingestion Bypass)
# Prevents multi-gigabyte SMEAR / CASES-99 file arrays from polluting Git history
data/**/*.nc
data/*.nc4
data/*.csv
*.nc
*.nc4
*.csv
!data/**/*.json

# 3. Environment & Operating System Garbage
.DS_Store
Thumbs.db
.vscode/
.idea/
*.ipynb_checkpoints/

# 4. Reference Utilities & Execution Scripts
# scripts/

# 5. Continuous Integration / Test Artifacts
# Protects against local run output leaks
test/scratch/
test/tmp/
*.log

# 6. TeX Source and LaTeX Build Subproducts
# Clear out typesetting noise while keeping source .tex files clean
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.xdv
# Ignore backup files common to text editors
*~
*.bak

# 7. Explicit Tracking Passes
# Explicitly force tracking of generated manuscript assets and compiled PDFs
!*.pdf